# Google AdSense (optional). Leave empty to show no ads at all.
# Set these when building the site, e.g. in apps/web/.env.production
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000

# One ad unit id per position. Only the first of each group is required: the others reuse it when left empty.
VITE_ADSENSE_SLOT_HOME=0000000000          # Home, between the features and the steps
VITE_ADSENSE_SLOT_HOME_BOTTOM=             # Home, after the learning cards (falls back to SLOT_HOME)
VITE_ADSENSE_SLOT_CONTENT=0000000000       # Rules, Guide, Openings, Puzzles, inside the content
VITE_ADSENSE_SLOT_BOTTOM=                  # end of Rules/Guide (falls back to SLOT_CONTENT)
VITE_ADSENSE_SLOT_RAIL=                    # sticky banner beside the Guide on wide screens (falls back to SLOT_CONTENT)
VITE_ADSENSE_SLOT_GAME=0000000000          # game screen sidebar on desktop
VITE_ADSENSE_SLOT_GAME_MOBILE=             # game screen on phones (falls back to SLOT_GAME)
